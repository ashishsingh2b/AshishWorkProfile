# =======================================================================
# Ashish Singh Portfolio - EmailJS & Contact Form Configuration
# =======================================================================
# Target Receiver Email: ashishsingh2b@gmail.com
CONTACT_RECEIVER_EMAIL=ashishsingh2b@gmail.com

# -----------------------------------------------------------------------
# OPTION 1: EmailJS (@emailjs/browser) - Recommended
# -----------------------------------------------------------------------
# 1. Log in at https://dashboard.emailjs.com/
# 2. Add an Email Service (e.g., Gmail connected to ashishsingh2b@gmail.com)
#    -> Copy the Service ID into VITE_EMAILJS_SERVICE_ID
# 3. Create an Email Template with:
#    - To Email: ashishsingh2b@gmail.com (or {{to_email}})
#    - Reply To: {{reply_to}}
#    - Subject:  New Inquiry: {{subject}} from {{company_name}}
#    - Content:
#        Company / Client Name: {{company_name}}
#        Sender Email: {{from_email}}
#        Subject / Job Role: {{subject}}
#        Message for Ashish:
#        {{message}}
#    -> Copy the Template ID into VITE_EMAILJS_TEMPLATE_ID
# 4. Go to Account -> API Keys -> Copy Public Key into VITE_EMAILJS_PUBLIC_KEY
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# -----------------------------------------------------------------------
# OPTION 2: Backend Providers (Optional Server-Side Alternatives)
# -----------------------------------------------------------------------
# WEB3FORMS_ACCESS_KEY=
# RESEND_API_KEY=
# FORMSPREE_ID=
